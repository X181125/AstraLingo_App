PORT=4000
NODE_ENV=development
# npm run dev:local starts a local PostgreSQL-compatible database automatically.
# For a separate PostgreSQL server, set DATABASE_URL then use npm run dev.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:51214/template1?connection_limit=1
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# console = local development inbox in .local/mailbox.jsonl; smtp = real delivery
MAIL_MODE=console
MAIL_FROM=AstraLingo <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
